{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danielrosehill.github.io/travel-packing/schema/plan.schema.json",
  "title": "plan.yaml",
  "description": "GENERATED by scripts/pack_solver.py. Regenerated, never hand-edited. See docs/data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_on", "solver", "objective", "bags"],
  "properties": {
    "generated_on": { "type": "string", "format": "date-time" },
    "solver": { "type": "string", "minLength": 1 },
    "objective": {
      "type": "string",
      "enum": ["max-min-headroom", "consolidate"]
    },
    "binding_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checked": { "$ref": "#/$defs/limit" },
        "cabin": { "$ref": "#/$defs/limit" },
        "personal": { "$ref": "#/$defs/limit" }
      }
    },
    "bags": {
      "type": "array",
      "items": { "$ref": "#/$defs/planBag" }
    },
    "unassigned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "name": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "overflow_ranking": {
      "type": "array",
      "description": "present only when pack_solver.py was run with --overflow; ascending cost per kg saved, i.e. drop from the top",
      "items": { "$ref": "#/$defs/overflowEntry" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "description": "hard problems the solver could not resolve (e.g. a bag whose tare exceeds its allowance)",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pieces": { "type": ["integer", "null"], "minimum": 0 },
        "max_weight_kg": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "planBag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "allowance_kg",
        "contents_kg",
        "projected_gross_kg",
        "headroom_kg",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "last_weighing_kg": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "most recent scale reading for this bag, echoed for comparison"
        },
        "type": { "type": "string", "enum": ["checked", "cabin", "personal"] },
        "allowance_kg": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "null = this bag type is uncapped by the binding allowance"
        },
        "tare_kg": { "type": ["number", "null"], "minimum": 0 },
        "contents_kg": { "type": "number", "minimum": 0 },
        "cube_tare_kg": { "type": "number", "minimum": 0 },
        "projected_gross_kg": { "type": "number", "minimum": 0 },
        "headroom_kg": {
          "type": ["number", "null"],
          "description": "null when allowance_kg is null"
        },
        "status": { "type": "string", "enum": ["ok", "tight", "over"] },
        "cubes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "items"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "loose_items": { "type": "array", "items": { "type": "string" } }
      }
    },
    "overflowEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "kg_saved", "cost_per_kg"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "item": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "bag": { "type": ["string", "null"] },
        "kg_saved": { "type": "number", "exclusiveMinimum": 0 },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "item value, or the tier proxy, reduced to the re-buy price where replaceable at destination"
        },
        "cost_per_kg": { "type": "number", "minimum": 0 },
        "replaceable": { "type": "boolean" },
        "replace_cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] },
        "pinned": { "type": "boolean" },
        "tier": {
          "type": "string",
          "enum": ["essential", "useful", "nice-to-have", "expendable"]
        },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
